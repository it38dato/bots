[Unit]
Description=Telegram dato38it-bot
After=network.target

[Service]
User=dato
Group=dato
WorkingDirectory=/home/Dato/dato38itbot/
VIRTUAL_ENV=/home/Dato/dato38itbot/telegaenv
Environment=PATH=$VIRTUAL_ENV/bin:$PATH
ExecStart=/home/Dato/dato38itbot/telegaenv/bin/python /home/Dato/dato38itbot/main.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
